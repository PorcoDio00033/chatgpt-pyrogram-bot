# Your OpenAI API key
OPENAI_API_KEY=XXX

# Persisten host path docker volume mount for storing logs/db data (e.g /home/user/chatgpt-pyrogram-bot)
HOST_PERSISTENT_PATH=/full/host/path

# Your Telegram bot token obtained using @BotFather
TELEGRAM_BOT_TOKEN=XXX
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram user ID of admins, or - to assign no admin
ADMIN_USER_IDS=ADMIN_1_USER_ID,ADMIN_2_USER_ID

# Comma separated list of telegram user IDs, or * to allow all
ALLOWED_TELEGRAM_USER_IDS=USER_ID_1,USER_ID_2

# Optional configuration, refer to the README for more details
# BUDGET_PERIOD=monthly
# USER_BUDGETS=*
# GUEST_BUDGET=100.0
# TOKEN_PRICE=0.002
# IMAGE_PRICES=0.016,0.018,0.02
# TRANSCRIPTION_PRICE=0.006
# VISION_TOKEN_PRICE=0.01
# ENABLE_QUOTING=true
# ENABLE_IMAGE_GENERATION=true
# ENABLE_TTS_GENERATION=true
# ENABLE_TRANSCRIPTION=true
# ENABLE_VISION=true
# PROXY=http://localhost:8080
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_SUPPORTED_INPUT=text,image,audio,video,pdf
# OPENAI_BASE_URL=https://example.com/v1/
# MAX_OPENAI_API_RETRIES=3
# ASSISTANT_PROMPT="You are a helpful assistant."
# SHOW_USAGE=false
# STREAM=true
# MAX_OUTPUT_TOKENS=1200
# MAX_MODEL_TOKENS=1000000
# MAX_HISTORY_SIZE=15
# MAX_CONVERSATION_AGE_MINUTES=180
# VOICE_REPLY_WITH_TRANSCRIPT_ONLY=true
# VOICE_REPLY_PROMPTS="Hi bot;Hey bot;Hi chat;Hey chat"
# N_CHOICES=1
# TEMPERATURE=1.0
# PRESENCE_PENALTY=0.0
# FREQUENCY_PENALTY=0.0
# IMAGE_MODEL=dall-e-3
# IMAGE_QUALITY=hd
# IMAGE_STYLE=natural
# IMAGE_SIZE=1024x1024
# IMAGE_FORMAT=document
# VISION_DETAIL="low"
# GROUP_TRIGGER_KEYWORD=""
# IGNORE_GROUP_TRANSCRIPTIONS=true
# IGNORE_GROUP_VISION=true
# TTS_MODEL="tts-1"
# TTS_VOICE="alloy"
# TTS_PRICES=0.015,0.030
# BOT_LANGUAGE=en
# VISION_MODEL="gpt-4.1-mini"
# WHISPER_PROMPT="Transcribe this audio."
# STT_USER_PROMPT="AUDIO TRANSCRIPTION:\n{transcript}\n\n{{{{ User }}}} PROMPT:\n{transcribe_user_prompt}"
# WHISPER_MODEL="whisper-1"
# ENABLE_RAW_REACTION=false
# REACTION_PROMPT="{{{{ User }}}} reacted to your message with {reaction}"

